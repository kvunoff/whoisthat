#!/bin/sh
# File capabilities are not stored by dpkg/rpm, so re-apply them on every
# install and upgrade. A failure here is a warning: proxy mode still works.
if command -v setcap >/dev/null 2>&1; then
    setcap cap_net_admin,cap_net_raw,cap_setpcap=+ep /usr/bin/whoisthat-core 2>/dev/null || {
        echo "warning: could not set capabilities on /usr/bin/whoisthat-core" >&2
        echo "run: sudo setcap cap_net_admin,cap_net_raw,cap_setpcap=+ep /usr/bin/whoisthat-core" >&2
    }
else
    echo "warning: setcap not found; TUN mode needs libcap" >&2
fi

# Legacy copies from an older install.sh or make install still carry
# capabilities and do not know about the allowlist.
for legacy in /usr/local/bin/whoisthat-core /usr/local/sbin/whoisthat-core; do
    [ -e "$legacy" ] || continue
    command -v setcap >/dev/null 2>&1 && setcap -r "$legacy" 2>/dev/null || true
done

# Root-owned state for the authorization allowlist and the host-wide lock.
# The per-user entry itself needs a real user: add it with authorize-core.
mkdir -p /etc/whoisthat/authorized.d /var/lib/whoisthat
chmod 0755 /etc/whoisthat /etc/whoisthat/authorized.d /var/lib/whoisthat
if [ ! -e /var/lib/whoisthat/run.lock ]; then
    : > /var/lib/whoisthat/run.lock
fi
chmod 0644 /var/lib/whoisthat/run.lock
echo "Authorize your user with: sudo /usr/lib/whoisthat/authorize-core --add <user>" >&2

# Refresh the caches so the menu entry and icon appear without a re-login.
command -v update-desktop-database >/dev/null 2>&1 &&
    update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
command -v gtk-update-icon-cache >/dev/null 2>&1 &&
    gtk-update-icon-cache -qtf /usr/share/icons/hicolor >/dev/null 2>&1 || true
