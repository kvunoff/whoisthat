#!/bin/sh
# Remove the authorization allowlist, the host-wide lock and any leftover file
# capabilities. Runs after the package files are gone, so the helper may no
# longer exist: do the cleanup inline.
set -e

# dpkg: upgrade, failed-upgrade; rpm: $1 = number of packages remaining.
case "${1:-}" in
    upgrade|failed-upgrade) exit 0 ;;
esac
if [ -n "${1:-}" ] && [ "${1:-}" -gt 0 ] 2>/dev/null; then
    exit 0
fi

for f in /etc/whoisthat/authorized.d/*; do
    [ -e "$f" ] || continue
    case "${f##*/}" in
        ''|*[!0-9]*) ;;
        *) rm -f "$f" ;;
    esac
done
rmdir /etc/whoisthat/authorized.d 2>/dev/null || true
rm -f /var/lib/whoisthat/run.lock 2>/dev/null || true

if command -v setcap >/dev/null 2>&1; then
    for bin in /usr/bin/whoisthat-core /usr/local/bin/whoisthat-core /usr/local/sbin/whoisthat-core; do
        [ -e "$bin" ] && setcap -r "$bin" 2>/dev/null || true
    done
fi

exit 0
