#!/bin/sh
# Root helper: move a program into the native split-tunnel cgroup and run it as
# the owning user. Needed because a non-root process cannot migrate itself into
# a root-created cgroup (the kernel also requires write access on the source
# cgroup, which lives in the root-only tree on non-systemd hosts).
#
#   sudo cgroup-run <uid> [--detach] -- <application> [args...]
#
# Only the user named by SUDO_UID may use their own uid; this prevents running
# a program as somebody else.
set -eu

die() { echo "whoisthat: $*" >&2; exit 1; }

if [ "$#" -lt 3 ]; then
    die "usage: cgroup-run <uid> [--detach] -- <application> [args...]"
fi

target_uid=$1
shift
case "$target_uid" in
    ''|*[!0-9]*) die "invalid uid: $target_uid" ;;
esac
[ "$target_uid" -ge 1000 ] || die "refusing uid $target_uid (must be >= 1000)"

caller=${SUDO_UID:-}
case "$caller" in
    ''|*[!0-9]*) die "cgroup-run must be started through sudo from a normal user" ;;
esac
[ "$caller" = "$target_uid" ] || die "refusing to run as uid $target_uid for caller uid $caller"

detach=0
if [ "${1:-}" = "--detach" ]; then
    detach=1
    shift
fi
[ "${1:-}" = "--" ] || die "expected -- before the application"
shift

CGROUP_ROOT=/sys/fs/cgroup
if [ "${WHOISTHAT_TEST_MODE:-}" = 1 ] && [ -n "${WHOISTHAT_CGROUP_ROOT:-}" ]; then
    CGROUP_ROOT=$WHOISTHAT_CGROUP_ROOT
fi
cgroup=$CGROUP_ROOT/whoisthat-$target_uid
[ -f "$cgroup/cgroup.procs" ] || die "cgroup not found: $cgroup (run: sudo /usr/lib/whoisthat/cgroup-setup \$USER)"

gid=$(getent passwd "$target_uid" 2>/dev/null | cut -d: -f4)
[ -n "$gid" ] || die "no passwd entry for uid $target_uid"

# setpriv is util-linux; busybox's minimal variant cannot change uid/gid.
setpriv --reuid 0 --regid 0 --clear-groups true >/dev/null 2>&1 \
    || die "util-linux setpriv is required (install util-linux)"

# Move ourselves (root) into the cgroup first; the membership survives the
# privilege drop and exec.
echo $$ > "$cgroup/cgroup.procs"

if [ "$detach" = 1 ]; then
    setsid setpriv --reuid "$target_uid" --regid "$gid" --init-groups -- "$@" \
        </dev/null >/dev/null 2>&1 &
    exit 0
fi

exec setpriv --reuid "$target_uid" --regid "$gid" --init-groups -- "$@"
